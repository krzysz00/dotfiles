{
  "env": {
    "ENABLE_LSP_TOOLS": "1",
    "CLAUDE_CODE_ACCESSIBILITY": "1",
    "CLAUDE_AX_STARTUP_QUIET_MS": "0"
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(echo *)",
      "Bash(test *)",
      "Bash(grep *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(cmake *)",
      "Bash(ninja *)",
      "Bash(llvm-lit *)",
      "Bash(FileCheck *)",
      "Bash(mlir-opt *)",
      "Bash(build/bin/llvm-lit *)",
      "Bash(bin/llvm-lit *)",
      "Bash(bin/FileCheck *)",
      "Bash(build/bin/FileCheck *)",
      "Bash(build/llvm-project/bin/llvm-lit *)",
      "Bash(build/llvm-project/bin/FileCheck *)",
      "Bash(build/bin/mlir-opt *)",
      "Bash(iree-compile *)",
      "Bash(iree-opt *)",
      "Bash(build/tools/iree-compile *)",
      "Bash(build/tools/iree-opt *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git status *)",
      "Bash(git merge-base *)",
      "Bash(git -C llvm-project show *)",
      "Bash(git -C llvm-project add *)",
      "Bash(git -C llvm-project status *)",
      "Bash(git -C llvm-project merge-base *)",
      "Bash(cd build)",
      "Bash(cd llvm-project)",
      "Bash(configure_iree.bash *)",
      "Bash(configure_mlir_llvm.bash *)",
      "Bash(./build_iree.bash *)",
      "Bash(./test_iree.bash *)",
      "Bash(./build_mlir.bash *)",
      "Bash(./build_llvm.bash *)",
      "Bash(peanut-review *)",
      "Edit(/marks.md)",
      "Edit(/project-map.md)",
      "Read(~/.claude/skills/peanut-gallery-review/personas/*)",
      "Read(~/.claude/skills/ask-the-peanut-gallery/*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(git push *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(sed * -i *)"
    ]
  },
  "model": "opus[1m]",
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "axScreenReader": true
}
